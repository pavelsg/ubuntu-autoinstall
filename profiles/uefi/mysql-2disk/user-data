#cloud-config
# DANGER: DISK ERASURE. Only for fresh VMs with exactly two target disks:
# OS 32 GiB (smaller), MySQL 48 GiB (larger), firmware: UEFI
# Network and identity are configured interactively during installation.
# Storage is fully automatic. Avoid exposing authentication data in public repositories.
autoinstall:
  version: 1
  locale: en_US.UTF-8
  keyboard:
    layout: us
    variant: ""
  source:
    id: ubuntu-server-minimal
  proxy: null
  snaps: []
  interactive-sections: [network, identity]
  ssh:
    install-server: true
  storage:
    swap:
      size: 0  # disable autogenerated swapfile; use lv_swap instead
    config:
      # The smaller (32 GiB) target is the OS disk.
      - {type: disk, id: os_disk, match: {size: smallest}, ptable: gpt, wipe: superblock-recursive}
      - {type: partition, id: esp, device: os_disk, size: 1G, flag: boot, grub_device: true}
      - {type: partition, id: boot_partition, device: os_disk, size: 2G}
      - {type: partition, id: os_pv, device: os_disk, size: -1}

      # The larger (48 GiB) target is an entire-disk LVM physical volume.
      - {type: disk, id: mysql_disk, match: {size: largest}, wipe: superblock-recursive}

      # Volume groups
      - {type: lvm_volgroup, id: os_vg, name: vg_os, devices: [os_pv]}
      - {type: lvm_volgroup, id: mysql_vg, name: vg_mysql, devices: [mysql_disk]}

      # OS logical volumes
      - {type: lvm_partition, id: os_root, name: lv_root, volgroup: os_vg, size: 10G}
      - {type: lvm_partition, id: os_var, name: lv_var, volgroup: os_vg, size: 5G}
      - {type: lvm_partition, id: os_varlog, name: lv_varlog, volgroup: os_vg, size: 5G}
      - {type: lvm_partition, id: os_home, name: lv_home, volgroup: os_vg, size: 2G}
      - {type: lvm_partition, id: os_swap, name: lv_swap, volgroup: os_vg, size: 6G}

      # MySQL logical volumes
      - {type: lvm_partition, id: mysql_data, name: lv_data, volgroup: mysql_vg, size: 32G}
      - {type: lvm_partition, id: mysql_redo, name: lv_redo, volgroup: mysql_vg, size: 4G}
      - {type: lvm_partition, id: mysql_binlog, name: lv_binlog, volgroup: mysql_vg, size: 8G}
      - {type: lvm_partition, id: mysql_tmp, name: lv_tmp, volgroup: mysql_vg}
      # lv_tmp uses all remaining space, nominally ~4 GiB minus LVM overhead.

      # Filesystems
      - {type: format, id: fs_esp, fstype: fat32, volume: esp}
      - {type: format, id: fs_boot, fstype: ext4, volume: boot_partition}
      - {type: format, id: fs_os_root, fstype: ext4, volume: os_root}
      - {type: format, id: fs_os_var, fstype: ext4, volume: os_var}
      - {type: format, id: fs_os_varlog, fstype: ext4, volume: os_varlog}
      - {type: format, id: fs_os_home, fstype: ext4, volume: os_home}
      - {type: format, id: fs_os_swap, fstype: swap, volume: os_swap}
      - {type: format, id: fs_mysql_data, fstype: ext4, volume: mysql_data}
      - {type: format, id: fs_mysql_redo, fstype: ext4, volume: mysql_redo}
      - {type: format, id: fs_mysql_binlog, fstype: ext4, volume: mysql_binlog}
      - {type: format, id: fs_mysql_tmp, fstype: ext4, volume: mysql_tmp}

      # Mounts. Curtin populates /etc/fstab; swap is mounted without a path.
      - {type: mount, id: mount_root, device: fs_os_root, path: /}
      - {type: mount, id: mount_boot, device: fs_boot, path: /boot}
      - {type: mount, id: mount_esp, device: fs_esp, path: /boot/efi}
      - {type: mount, id: mount_var, device: fs_os_var, path: /var}
      - {type: mount, id: mount_varlog, device: fs_os_varlog, path: /var/log}
      - {type: mount, id: mount_home, device: fs_os_home, path: /home}
      - {type: mount, id: mount_swap, device: fs_os_swap}
      - {type: mount, id: mount_mysql_data, device: fs_mysql_data, path: /mysql_data}
      - {type: mount, id: mount_mysql_redo, device: fs_mysql_redo, path: /mysql_redo}
      - {type: mount, id: mount_mysql_binlog, device: fs_mysql_binlog, path: /mysql_binlog}
      - {type: mount, id: mount_mysql_tmp, device: fs_mysql_tmp, path: /mysql_tmp}
