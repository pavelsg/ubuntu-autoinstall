#cloud-config
# DANGER: DISK ERASURE. Only for a fresh VM with its target disk at /dev/sda.
# Network and identity are configured interactively during installation.
# IPv6 disabled on the INSTALLED OS via /etc/sysctl.d/; installer networking is unaffected.
autoinstall:
  version: 1
  locale: en_US.UTF-8
  keyboard:
    layout: us
    variant: ""
  source:
    id: ubuntu-server-minimal
  proxy: null
  snaps: []
  interactive-sections: [network, identity]
  ssh:
    install-server: true
  storage:
    swap:
      size: 0  # disable autogenerated swapfile; use lv_swap instead
    config:
      # Match the MySQL profile OS layout, targeting only /dev/sda.
      - {type: disk, id: os_disk, path: /dev/sda, ptable: gpt, wipe: superblock-recursive, grub_device: true}
      - {type: partition, id: bios_grub, device: os_disk, size: 1M, flag: bios_grub}
      - {type: partition, id: boot_partition, device: os_disk, size: 2G}
      - {type: partition, id: os_pv, device: os_disk, size: -1}

      # Volume groups
      - {type: lvm_volgroup, id: os_vg, name: vg_os, devices: [os_pv]}

      # OS logical volumes
      - {type: lvm_partition, id: os_root, name: lv_root, volgroup: os_vg, size: 10G}
      - {type: lvm_partition, id: os_var, name: lv_var, volgroup: os_vg, size: 5G}
      - {type: lvm_partition, id: os_varlog, name: lv_varlog, volgroup: os_vg, size: 5G}
      - {type: lvm_partition, id: os_home, name: lv_home, volgroup: os_vg, size: 2G}
      - {type: lvm_partition, id: os_swap, name: lv_swap, volgroup: os_vg, size: 6G}

      # Filesystems
      - {type: format, id: fs_boot, fstype: ext4, volume: boot_partition}
      - {type: format, id: fs_os_root, fstype: ext4, volume: os_root}
      - {type: format, id: fs_os_var, fstype: ext4, volume: os_var}
      - {type: format, id: fs_os_varlog, fstype: ext4, volume: os_varlog}
      - {type: format, id: fs_os_home, fstype: ext4, volume: os_home}
      - {type: format, id: fs_os_swap, fstype: swap, volume: os_swap}

      # Mounts. Curtin populates /etc/fstab; Subiquity requires an explicit empty path for swap.
      - {type: mount, id: mount_root, device: fs_os_root, path: /}
      - {type: mount, id: mount_boot, device: fs_boot, path: /boot}
      - {type: mount, id: mount_var, device: fs_os_var, path: /var}
      - {type: mount, id: mount_varlog, device: fs_os_varlog, path: /var/log}
      - {type: mount, id: mount_home, device: fs_os_home, path: /home}
      - {type: mount, id: mount_swap, device: fs_os_swap, path: ""}

  late-commands:
    - |
      cat > /target/etc/sysctl.d/99-disable-ipv6.conf <<'EOF'
      net.ipv6.conf.all.disable_ipv6 = 1
      net.ipv6.conf.default.disable_ipv6 = 1
      EOF
